<Window x:Class="ScreanTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreanTranslate"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Visibility="Hidden">

    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon" IconSource="/icon.ico" ToolTipText="ScreanTranslate">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <ContextMenu.Resources>
                        <Style TargetType="{x:Type ContextMenu}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                        </Style>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#333333" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Height" Value="28" />
                            <Setter Property="Padding" Value="10,0,10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0" />
                                    <Setter Property="Foreground" Value="#000000" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </ContextMenu.Resources>

                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border CornerRadius="8" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="4">
                                <ItemsPresenter/>
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
 
                    <MenuItem Header="Кнопка">
                        <MenuItem.Icon>
                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                              Fill="#333333" Stretch="Uniform" Width="12" Height="12"/>
                        </MenuItem.Icon>
                        <MenuItem x:Name="SleshMenuItem" Header="\" IsCheckable="True" IsChecked="{Binding IsSleshChecked}" Command="{Binding SleshCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="\" FontSize="12" FontWeight="Bold"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="AltMenuItem" Header="Alt + \" IsCheckable="True" IsChecked="{Binding IsAltChecked}" Command="{Binding AltCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="Alt" FontSize="10" FontWeight="Bold"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CtrlMenuItem" Header="Ctrl + \" IsCheckable="True" IsChecked="{Binding IsCtrlChecked}" Command="{Binding CtrlCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="Ctrl" FontSize="10" FontWeight="Bold"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="История" Command="{Binding HistoryCommand}">
                        <MenuItem.Icon>
                            <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" 
                              Fill="#333333" Stretch="Uniform" Width="12" Height="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Выход" Command="{Binding ExitCommand}">
                        <MenuItem.Icon>
                            <Path Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" 
                              Fill="#333333" Stretch="Uniform" Width="12" Height="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
